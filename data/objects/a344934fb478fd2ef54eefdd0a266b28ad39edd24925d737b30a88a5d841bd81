<ref pm:link-pointer-type="person" target="per352" n="Coe, Joseph">Joseph
Coe</ref>
<ref pm:link-pointer-type="person" target="per661" n="Kingsbury, Joseph Corrodon">Joseph Kingsbury</ref> &amp;
<ref pm:link-pointer-type="person" target="per64" n="Harris, Martin">Martin
</ref><lb/><add resp="WordConversion">*</add><note xml:id="JSPPJ1_d1e46417" pm:link-target-type="text" type="editorial-footnote-text">The asterisk,

<p xml:id="JSPPJ1_d1e7106" rend="indent"><choice>
                <reg resp="darowskijf" type="Expanded"><date when-iso="1834-03-14">friday 14<hi rend="superscript">th</hi></date>
                  <handShift resp="seniels" scribe="per46"/><note resp="apple" xml:id="dc7ea153-c96e-438c-9a4e-13b96221490e" pm:link-target-type="text" type="editorial-footnote-scribe"><ref pm:link-pointer-type="person" target="per117" n="Pratt, Parley Parker">Parley P. Pratt</ref> handwriting
                    ends; <ref pm:link-pointer-type="person" target="per46" n="Smith, Joseph, Jr.">JS</ref> begins.</note>in</reg>
                <reg resp="darowskijf" type="Clear">In</reg>
              </choice>
              <ref pm:link-pointer-type="person" target="per665" n="Beman, Alvah">F<supplied resp="WordConversion">ather Alvah</supplied> Beaman</ref><reg resp="darowskijf" type="Clear">’</reg>s<reg resp="darowskijf" type="Clear">.</reg><note xml:id="JSPPJ1_d1e7120" pm:link-target-type="text" type="editorial-footnote">At
                  <ref pm:link-pointer-type="place" target="x8194" n="Avon Township, Livingston County, New York">Avon</ref>, New York. <ref pm:link-pointer-type="person" target="per117" n="Parley P. Pratt">Parley P. Pratt</ref> later recalled that <ref pm:link-pointer-type="person" target="per46" n="Joseph Smith Jr.">JS</ref>

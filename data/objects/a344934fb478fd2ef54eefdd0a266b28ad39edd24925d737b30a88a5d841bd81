<p xml:id="JSPPJ1_d1e1183" rend="indent"><choice><reg resp="darowskijf" type="Expanded"><date when-iso="1832-12-03">December 3<hi rend="superscript">d</hi></date></reg><reg resp="darowskijf" type="Clear"/></choice> <choice><reg resp="darowskijf" type="Expanded"><ref pm:link-pointer-type="topic" target="x4098">ordaind</ref></reg><reg resp="darowskijf" type="Clear">Ordained</reg></choice>
<ref pm:link-pointer-type="person" target="per650" n="Noah Packard"><choice><reg resp="darowskijf" type="Expanded">Brothe<supplied resp="WordConversion">r</supplied></reg><reg resp="darowskijf" type="Clear">Brother</reg></choice> <lb/><choice><reg resp="darowskijf" type="Expanded">Packherd</reg><reg resp="darowskijf" type="Clear"/></choice>
<supplied resp="WordConversion">Noah Packard</supplied></ref> with my own
<ref pm:link-pointer-type="topic" target="x4092">hands</ref><reg resp="darowskijf" type="Clear"/><reg resp="darowskijf" type="Clear">.</reg><note xml:id="JSPPJ1_d1e1204" pm:link-target-type="text" type="editorial-footnote"><ref pm:link-pointer-type="person" target="per46" n="Joseph Smith Jr.">JS</ref> ordained

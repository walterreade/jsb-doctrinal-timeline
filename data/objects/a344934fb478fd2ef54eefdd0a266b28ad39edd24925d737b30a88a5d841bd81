              </choice> sake<reg resp="darowskijf" type="Clear">.</reg> Amen<reg resp="darowskijf" type="Clear">.</reg><note xml:id="JSPPJ1_d1e3203" pm:link-target-type="text" type="editorial-footnote">A <date when-iso="1833-10-12">12 October 1833</date>

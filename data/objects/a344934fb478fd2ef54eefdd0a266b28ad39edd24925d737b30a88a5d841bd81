<ref pm:link-pointer-type="person" target="per123" n="Orson Pratt">Orson
<lb/>Pratt</ref><reg resp="darowskijf" type="Clear">,</reg><note xml:id="JSPPJ1_d1e1239" pm:link-target-type="text" type="editorial-footnote">Earlier revelations assigned

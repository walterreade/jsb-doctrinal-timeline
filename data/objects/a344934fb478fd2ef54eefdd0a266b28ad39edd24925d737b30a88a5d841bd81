<ref pm:link-pointer-type="person" target="x4241" n="Bosley, Edmund"><choice><reg resp="darowskijf" type="Expanded">farther<del resp="Conversion">s</del></reg><reg resp="darowskijf" type="Clear"/></choice>
<supplied resp="WordConversion">Father Edmund</supplied> Bosley</ref><reg resp="darowskijf" type="Clear">’</reg>s.<note xml:id="JSPPJ1_d1e7076" pm:link-target-type="text" type="editorial-footnote">At

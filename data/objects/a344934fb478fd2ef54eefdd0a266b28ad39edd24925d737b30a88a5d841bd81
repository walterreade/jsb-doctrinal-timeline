<ref pm:link-pointer-type="person" target="per924" n="Heman Hyde">Heman
<choice><reg resp="darowskijf" type="Expanded">hide</reg><reg resp="darowskijf" type="Clear"/></choice> <supplied resp="WordConversion">Hyde</supplied></ref><reg resp="DarowskiJF" type="Clear">,</reg><note xml:id="JSPPJ1_d1e7032" pm:link-target-type="text" type="editorial-footnote"><ref pm:link-pointer-type="person" target="per117" n="Parley P. Pratt">Parley P. Pratt</ref> later recorded that
